NODE_ENV=development
PORT=4000
MONGODB_URI=
DEV_AUTH_MOCK=false
DEV_AUTH_ROLE=customer
# Firebase web app settings (public client configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Must match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Absolute path to a Firebase Admin service-account JSON file; keep it outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Optional server fallback; use only approved production coverage, prices, limits, windows, and terms.
SHIPMENT_RULES_JSON=
